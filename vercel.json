{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/auth/login", "destination": "/api/auth-login" },
    { "source": "/api/auth/callback", "destination": "/api/auth-callback" },
    { "source": "/api/gemini", "destination": "/api/gemini" },
    { "source": "/api/grok-vision", "destination": "/api/grok-vision" },
    { "source": "/api/models", "destination": "/api/models" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
